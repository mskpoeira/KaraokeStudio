<Window x:Class="KaraokeStudio.LyricsLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca de letras" Height="650" Width="1050" MinHeight="500" MinWidth="820"
        Background="#111827" Foreground="White" WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="BIBLIOTECA DE LETRAS" FontSize="24" FontWeight="Bold" Foreground="#A78BFA"/>
      <TextBlock Text="Use Ctrl ou Shift para selecionar várias letras." Foreground="#CBD5E1" Margin="0,4,0,8"/>
    </StackPanel>
    <DataGrid x:Name="LyricsGrid" Grid.Row="1" Margin="0,10" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Extended" SelectionUnit="FullRow" Background="#1F2937" Foreground="White"
              RowBackground="#1F2937" AlternatingRowBackground="#273449">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Música" Binding="{Binding Title}" Width="3*"/>
        <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="2*"/>
        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
        <DataGridTextColumn Header="Baixado em" Binding="{Binding DownloadedAtText}" Width="145"/>
        <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="2">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#CBD5E1"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Selecionar todas" Click="SelectAll_Click" Background="#334155" Foreground="White"/>
        <Button Content="Excluir selecionadas" Click="DeleteSelected_Click" Background="#B45309" Foreground="White"/>
        <Button Content="Excluir todas" Click="DeleteAll_Click" Background="#B91C1C" Foreground="White"/>
        <Button Content="Voltar" Click="Close_Click" Background="#475569" Foreground="White"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
