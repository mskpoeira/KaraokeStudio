<Window x:Class="KaraokeStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Karaokê Studio 0.5.2" Height="940" Width="1340" MinHeight="850" MinWidth="1150" Background="#111827" Foreground="#F9FAFB">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="🔎 Pesquisar letras" Click="SearchLyrics_Click" Background="#7C3AED" Foreground="White"/><Button Content="Biblioteca de letras" Click="LyricsLibrary_Click" Background="#334155" Foreground="White"/><Button Content="Sincronizar letras" Click="SyncAllLyrics_Click" Background="#0369A1" Foreground="White"/><Button Content="Telão" Click="Screen_Click"/><Button Content="Backup" Click="Backup_Click" Background="#374151" Foreground="White"/></StackPanel><TextBlock Text="KARAOKÊ STUDIO" FontSize="28" FontWeight="Bold" Foreground="#A78BFA"/><TextBlock Text="  v0.5.2" FontSize="16" VerticalAlignment="Center" Foreground="#9CA3AF"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Background="#1F2937" CornerRadius="12" Padding="14" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Importar acervo" Click="Import_Click" Background="#7C3AED" Foreground="White"/><TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" ToolTip="Pesquisar artista, música ou gênero"/></DockPanel><WrapPanel><Button Content="Vincular áudio local" Click="LinkAudio_Click"/><Button Content="Baixar link direto" Click="DownloadAudio_Click"/><Button Content="YouTube ↗" Click="FindYouTube_Click"/><Button Content="Spotify ↗" Click="FindSpotify_Click"/></WrapPanel><TextBlock Text="Prioridade offline. Buscas externas abrem no navegador." FontSize="11"/></StackPanel>
        <DataGrid x:Name="SongsGrid" Grid.Row="1" Margin="4,12,4,4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="SongsGrid_DoubleClick" Background="#111827" Foreground="White" RowBackground="#1F2937" AlternatingRowBackground="#253247" HeadersVisibility="Column">
          <DataGrid.Columns><DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="2*"/><DataGridTextColumn Header="Música" Binding="{Binding Title}" Width="3*"/><DataGridTextColumn Header="Origem" Binding="{Binding SourceLabel}" Width="140"/><DataGridTextColumn Header="Letra" Binding="{Binding LyricsStatus}" Width="60"/><DataGridTextColumn Header="Formato" Binding="{Binding Format}" Width="75"/></DataGrid.Columns>
        </DataGrid></Grid></Border>
      <Border Grid.Column="1" Background="#1F2937" CornerRadius="12" Padding="14" Margin="10,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="AGORA NO PALCO" Foreground="#A78BFA" FontWeight="Bold"/>
        <Border Grid.Row="1" Background="Black" CornerRadius="8" Margin="0,10"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Volume="0.8" MediaOpened="Player_MediaOpenedRecovery" MediaEnded="PerformanceEnded" MediaFailed="Player_MediaFailedWithRecovery"/></Border>
        <StackPanel Grid.Row="2"><TextBlock x:Name="NowPlaying" Text="Nenhuma música" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="CurrentSinger" Foreground="#9CA3AF"/><TextBlock x:Name="SourceText" Text="Origem: nenhuma mídia" FontSize="11" TextTrimming="CharacterEllipsis"/><Slider x:Name="PositionSlider" Minimum="0" ValueChanged="PositionSlider_ValueChanged"/><WrapPanel><Button Content="▶ Reproduzir" Click="Play_Click"/><Button Content="⏸ Pausar" Click="Pause_Click"/><Button Content="⏹ Parar" Click="Stop_Click"/><Button Content="Pular" Click="Next_Click"/></WrapPanel><DockPanel><TextBlock Text="Volume"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8" ValueChanged="Volume_ValueChanged"/></DockPanel></StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="LETRA" FontWeight="Bold"/><DockPanel><TextBlock Text="Ajuste LRC (ms)"/><Slider x:Name="LyricsOffsetSlider" Minimum="-5000" Maximum="5000" Value="0" TickFrequency="25" IsSnapToTickEnabled="True" ToolTip="Positivo adianta a letra; negativo atrasa"/><TextBlock Text="{Binding Value, ElementName=LyricsOffsetSlider, StringFormat=F0}"/></DockPanel><ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LyricsText" Text="Selecione uma música ou letra do acervo." FontSize="22" TextAlignment="Center" TextWrapping="Wrap" Margin="8,20"/></ScrollViewer><TextBlock Text="Cantor(a) ou cantores(as)"/><TextBox x:Name="SingersBox" Text="Convidado"/><Button Content="Dar nota do apresentador (0–100)" Click="Score_Click"/><TextBlock Text="15 s de resultado + 5 s até a próxima" FontSize="11"/><TabControl Height="130"><TabItem Header="Lista de espera"><ListBox x:Name="QueueList" Background="#111827" Foreground="White"/></TabItem><TabItem Header="Ranking"><ListBox x:Name="RankingList" Background="#111827" Foreground="White"/></TabItem></TabControl></StackPanel>
        <WrapPanel Grid.Row="4"><Button Content="Adicionar à espera" Click="AddQueue_Click" Background="#374151" Foreground="White"/><Button Content="Remover da fila" Click="RemoveQueue_Click" Background="#7F1D1D" Foreground="White"/><Button Content="↑" Click="MoveUp_Click"/><Button Content="↓" Click="MoveDown_Click"/><Button Content="Editar nomes" Click="EditSingers_Click"/><Button Content="Favoritar" Click="Favorite_Click" Background="#854D0E" Foreground="White"/></WrapPanel>
      </Grid></Border>
    </Grid>
    <StatusBar Grid.Row="2" Margin="0,12,0,0" Background="#111827"><StatusBarItem><TextBlock x:Name="StatusText" Text="Preparando banco de dados..."/></StatusBarItem></StatusBar>
  </Grid>
</Window>
