<Window x:Class="KaraokeStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Karaokê Studio 0.4.2" Height="760" Width="1340" MinHeight="650" MinWidth="1150" Background="#111827" Foreground="#F9FAFB">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="🔎 Pesquisar letras" Click="SearchLyrics_Click" Background="#7C3AED" Foreground="White"/><Button Content="Biblioteca de letras" Click="LyricsLibrary_Click" Background="#334155" Foreground="White"/><Button Content="Sincronizar letras" Click="SyncLyrics_Click" Background="#0369A1" Foreground="White"/><Button Content="Telão" Click="Screen_Click"/><Button Content="Backup" Click="Backup_Click" Background="#374151" Foreground="White"/></StackPanel><TextBlock Text="KARAOKÊ STUDIO" FontSize="28" FontWeight="Bold" Foreground="#A78BFA"/><TextBlock Text="  v0.4.2" FontSize="16" VerticalAlignment="Center" Foreground="#9CA3AF"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Background="#1F2937" CornerRadius="12" Padding="14" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><Button DockPanel.Dock="Right" Content="Importar acervo" Click="Import_Click" Background="#7C3AED" Foreground="White"/><TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" ToolTip="Pesquisar artista, música ou gênero"/></DockPanel>
        <DataGrid x:Name="SongsGrid" Grid.Row="1" Margin="4,12,4,4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="SongsGrid_DoubleClick" Background="#111827" Foreground="White" RowBackground="#1F2937" AlternatingRowBackground="#253247" HeadersVisibility="Column">
          <DataGrid.Columns><DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="2*"/><DataGridTextColumn Header="Música" Binding="{Binding Title}" Width="3*"/><DataGridTextColumn Header="Gênero" Binding="{Binding Genre}" Width="*"/><DataGridTextColumn Header="Letra" Binding="{Binding LyricsStatus}" Width="60"/><DataGridTextColumn Header="Formato" Binding="{Binding Format}" Width="75"/></DataGrid.Columns>
        </DataGrid></Grid></Border>
      <Border Grid.Column="1" Background="#1F2937" CornerRadius="12" Padding="14" Margin="10,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="AGORA NO PALCO" Foreground="#A78BFA" FontWeight="Bold"/>
        <Border Grid.Row="1" Background="Black" CornerRadius="8" Margin="0,10"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaEnded="Player_MediaEnded"/></Border>
        <StackPanel Grid.Row="2"><TextBlock x:Name="NowPlaying" Text="Nenhuma música" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="CurrentSinger" Foreground="#9CA3AF"/><Slider x:Name="PositionSlider" Minimum="0" ValueChanged="PositionSlider_ValueChanged"/><WrapPanel><Button Content="▶ Reproduzir" Click="Play_Click"/><Button Content="⏸ Pausar" Click="Pause_Click"/><Button Content="⏹ Parar" Click="Stop_Click"/><Button Content="Próxima" Click="Next_Click"/></WrapPanel></StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="LETRA" FontWeight="Bold"/><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LyricsText" Text="Selecione uma música ou letra do acervo." FontSize="22" TextAlignment="Center" TextWrapping="Wrap" Margin="8,20"/></ScrollViewer><TextBlock Text="FILA DE CANTORES" FontWeight="Bold"/><ListBox x:Name="QueueList" Background="#111827" Foreground="White" Margin="0,8"/></StackPanel>
        <WrapPanel Grid.Row="4"><Button Content="Adicionar selecionada à fila" Click="AddQueue_Click" Background="#374151" Foreground="White"/><Button Content="Remover da fila" Click="RemoveQueue_Click" Background="#7F1D1D" Foreground="White"/><Button Content="Favoritar" Click="Favorite_Click" Background="#854D0E" Foreground="White"/></WrapPanel>
      </Grid></Border>
    </Grid>
    <StatusBar Grid.Row="2" Margin="0,12,0,0" Background="#111827"><StatusBarItem><TextBlock x:Name="StatusText" Text="Preparando banco de dados..."/></StatusBarItem></StatusBar>
  </Grid>
</Window>
